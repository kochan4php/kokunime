# Matriks environment variable Kokunime.
# Wajib: NEXT_PUBLIC_SITE_URL (produksi). Sisanya opsional — fitur terkait
# otomatis nonaktif saat variabelnya kosong.

# ── Identitas situs (build-time) ─────────────────────────────────────────────
# Origin publik (canonical, sitemap, IndexNow, metadata OG). Pakai URL absolut.
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Token admin & metrik ─────────────────────────────────────────────────────
# Bearer token /api/metrics (Prometheus). Kosong → endpoint 404 (privat).
METRICS_TOKEN=
# Bearer token /api/admin/* (revalidate, warm index, feature flags, uptime,
# slow log). Fallback ke METRICS_TOKEN.
ADMIN_TOKEN=
# Allowlist IP untuk /api/admin/*, dipisah koma. Kosong = semua IP diizinkan.
ADMIN_ALLOWLIST=

# ── Redis (opsional) ─────────────────────────────────────────────────────────
# Cache bersama, pub/sub invalidasi antar-instance, rate-limit, counter uptime,
# feature flags. Tanpa ini semua turun ke fallback in-memory dengan aman.
# docker compose --profile cache up -d
REDIS_URL=redis://localhost:6379

# ── Observability ────────────────────────────────────────────────────────────
# Webhook Discord: laporan error server/client + alert Web Vitals lambat.
# Kosong = pelaporan nonaktif (silent no-op).
ERROR_WEBHOOK_URL=
# Webhook alert ops untuk scripts/alert.mjs (fallback: ERROR_ / DISCORD_WEBHOOK_URL).
ALERT_WEBHOOK_URL=
# Fraksi 0..1 laporan error client yang diteruskan (default 1).
ERROR_REPORT_SAMPLE=1
# Ambang log slow-request server dalam ms (default 1000).
SLOW_REQUEST_MS=1000
# debug | info | warn | error (default info).
LOG_LEVEL=info
# Sink file opsional + rotasi ukuran (default 5MB, simpan .1–.3).
LOG_FILE=
LOG_MAX_BYTES=5242880

# ── Keamanan ─────────────────────────────────────────────────────────────────
# 1 = CSP keluar dari report-only ke enforce + Trusted Types. Lihat ADR 0008.
CSP_ENFORCE=0

# ── Hanya untuk scripts/CI (tidak dibaca oleh aplikasi) ─────────────────────
# Target probe/load/e2e/warm: BASE, BASE_URL, SITE_URL, PRODUCTION_URL.
# Budget script: BUNDLE_BUDGET_THRESHOLD, WARM_LIMIT, LOAD_P95_BUDGET_MS,
# LOAD_MIN_SUCCESS_RATE, LOAD_SOAK_SECONDS.
# Alert script: DISCORD_WEBHOOK_URL, ALERT_SOURCE.
# Matrix lengkap dengan default + perilaku: docs/env.md
