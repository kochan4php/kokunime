# Public origin of the site (canonical URLs, sitemap, IndexNow, OG metadata).
NEXT_PUBLIC_SITE_URL=https://example.com

# Discord webhook used for server/client error reports + deploy alerts.
# Leave empty to disable error reporting.
ERROR_WEBHOOK_URL=

# Redis connection for the shared cache tier and rate-limit store (optional).
# With docker compose: docker compose --profile cache up -d
REDIS_URL=redis://localhost:6379
