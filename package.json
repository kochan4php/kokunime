{
  "name": "kokunime",
  "version": "1.0.0",
  "private": true,
  "author": "Deo Subarno",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "setup": "pnpm test && pnpm build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prettier:check": "biome format .",
    "prettier:fix": "biome format --write .",
    "test": "vitest run",
    "docker:up": "pnpm docker:down && docker compose up -d",
    "docker:down": "docker compose down",
    "changelog": "node scripts/release-changelog.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "backup:cache": "node scripts/backup-cache.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "size:budget": "node scripts/file-size-budget.mjs",
    "audit:client": "node scripts/find-client-unnecessary.mjs",
    "loadtest": "node scripts/load-test.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "a11y:targets": "node scripts/touch-targets.mjs",
    "offline:smoke": "node scripts/offline-smoke.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "css:report": "node scripts/css-usage-report.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build && node scripts/no-third-party.mjs && node scripts/deps-allowlist.mjs && pnpm bundle:budget && pnpm size:budget && node scripts/find-unused-exports.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "audit:meta": "node scripts/audit-meta.mjs",
    "prepare": "husky",
    "check:third-party": "node scripts/no-third-party.mjs",
    "check:deps": "node scripts/deps-allowlist.mjs",
    "a11y:v2": "node scripts/a11y-v2.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.3.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css}": ["node scripts/lint-staged-chunk.mjs"]
  }
}
