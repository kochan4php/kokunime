{
  "name": "kokunime",
  "version": "1.0.0",
  "private": true,
  "author": "Deo Subarno",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "setup": "npm test && npm run build",
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prettier:check": "biome format .",
    "prettier:fix": "biome format --write .",
    "test": "vitest run",
    "docker:up": "npm run docker:down && docker compose up -d",
    "docker:down": "docker compose down",
    "changelog": "node scripts/release-changelog.mjs",
    "backup:cache": "node scripts/backup-cache.mjs",
    "loadtest": "node scripts/load-test.mjs",
    "lighthouse": "lhci autorun",
    "e2e": "node scripts/e2e-smoke.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
